# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Alpaca Market Data (free account at https://alpaca.markets -> Paper trading -> API keys)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Finnhub (free key at https://finnhub.io/register)
FINNHUB_API_KEY=

# Anthropic (https://console.anthropic.com -> API Keys). Only used in Standard reasoning mode.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email. No key needed.
SEC_USER_AGENT=Conviction2 your.email@example.com
