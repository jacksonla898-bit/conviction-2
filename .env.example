# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Alpaca Market Data (free account at https://alpaca.markets -> Paper trading -> API keys)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Finnhub (free key at https://finnhub.io/register)
FINNHUB_API_KEY=

# Anthropic (https://console.anthropic.com -> API Keys). Only used in Standard reasoning mode.
ANTHROPIC_API_KEY=

# FRED (Federal Reserve Economic Data): Treasury yields and the risk-free rate.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html  (server-side only; never prefix with VITE_)
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email. No key needed.
SEC_USER_AGENT=Conviction2 your.email@example.com

# Supabase analysis log (optional; without these the app works but shows "Run not saved to log").
# Supabase dashboard -> Project Settings -> Data API: copy the Project URL.
# Supabase dashboard -> Project Settings -> API Keys: copy the service_role key (or a "secret" key).
# SERVER-SIDE ONLY: never prefix these with VITE_ and never paste the key into client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
